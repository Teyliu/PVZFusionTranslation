<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Nullable>disable</Nullable>
		<IsPackable>false</IsPackable>
		<FileVersion>1.0.0</FileVersion>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<NeutralLanguage>en-US</NeutralLanguage>
		<TargetFramework>net6.0</TargetFramework>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<AssemblyName>PvZ_Fusion_Translator</AssemblyName>
		<RootNamespace>PvZ_Fusion_Translator</RootNamespace>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'BepInEx'">
		<DefineConstants>$(DefineConstants);BEPINEX</DefineConstants>
		<RestoreAdditionalProjectSources>
			https://api.nuget.org/v3/index.json;
			https://nuget.bepinex.dev/v3/index.json;
			https://nuget.samboy.dev/v3/index.json
		</RestoreAdditionalProjectSources>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'MelonLoader'">
		<DefineConstants>$(DefineConstants);MELONLOADER</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="*.cs" />
		<Compile Include="Patches/**/*.cs" />
		<Compile Include="AssetStore/**/*.cs" />
		<None Remove=".gitignore" />
		<None Remove=".gitattributes" />
		<None Remove="Instantiation/**" />
		<None Remove="Storage_Strings/**" />
		<None Remove="Storage_Textures/**" />
		<None Remove="Translation Files/**" />
        <Content Include="../Paths.local.props*"/>
		<EmbeddedResource Remove="Instantiation/**" />
		<EmbeddedResource Remove="Storage_Strings/**" />
		<EmbeddedResource Remove="Storage_Textures/**" />
        <AdditionalFiles Include="../Paths.local.props*"/>
		<EmbeddedResource Remove="Translation Files/**" />
	    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' == 'BepInEx'">
		<Reference Include="$(BepInExGamePath)/BepInEx/core/*.dll"/>
		<Reference Include="$(BepInExGamePath)/BepInEx/interop/*.dll"/>
		<PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
	    <Reference Include="$(BepInExGamePath)/BepInEx/plugins/AudioImportLib.BepInEx.dll"/>
		<PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' == 'MelonLoader'">
		<Reference Include="$(MelonLoaderGamePath)/MelonLoader/net6/*.dll"/>
		<Reference Include="$(MelonLoaderGamePath)/Mods/AudioImportLib.dll"/>
		<Reference Include="$(MelonLoaderGamePath)/MelonLoader/Il2CppAssemblies/*.dll"/>
	</ItemGroup>
	<Import Condition="Exists('../Paths.local.props')" Project="../Paths.local.props"/>
	<!-- Remove the template if all necessary item groups are filled. -->
    <ItemGroup Condition="('$(Configuration)' == 'BepInEx' and '$(BepInExGamePath)' != '') or ('$(Configuration)' == 'MelonLoader' and '$(MelonLoaderGamePath)' != '')">
        <Content Remove="../Paths.local.props.template"/>
        <AdditionalFiles Remove="../Paths.local.props.template"/>
    </ItemGroup>
    <Target Name="ValidateLocalProperties" BeforeTargets="PreBuildEvent">
        <Error Condition="'$(Configuration)' == 'BepInEx' and '$(BepInExGamePath)' == ''" Text="Game path for BepInEx missing. Copy the template Paths.local.props.template and rename it to Paths.local.props and fill each tag with the respective directories on your local system."/>
        <Error Condition="'$(Configuration)' == 'MelonLoader' and '$(MelonLoaderGamePath)' == ''" Text="Game path for MelonLoader missing. Copy the template Paths.local.props.template and rename it to Paths.local.props and fill each tag with the respective directories on your local system."/>
    </Target>
</Project>
